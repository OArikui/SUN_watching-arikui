{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SUN_watching-sun_find_west_v2-parameta",
  "type": "object",
  "properties": {
    "Camera": {
      "type": "object",
      "properties": {
        "basic_parameters": {
          "type": "object",
          "properties": {
            "exposure": {
              "type": "integer",
              "minimum": 32,
              "maximum": 20000,
              "default": 100,
              "description": "ASI_EXPOSURE: 露出時間 (μs)。ASI432MMスペック範囲: 32μs〜2000s。ND5.0太陽観測用推奨: 100〜1000"
            },
            "gain": {
              "type": "integer",
              "minimum": 0,
              "maximum": 400,
              "default": 0,
              "description": "ASI_GAIN: ゲイン (0〜400)。太陽観測は基本0。HCGモードはGain 140で自動ON(低ノイズ化)"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 15,
              "description": "ASI_OFFSET or ASI_BRIGHTNESS: オフセット (黒レベルの切り捨て防止)"
            },
            "gamma": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50,
              "description": "ASI_GAMMA: ガンマ補正値 (50=補正なし リニア特性維持)"
            }
          }
        },
        "transfer_settings": {
          "type": "object",
          "properties": {
            "band_width": {
              "type": "integer",
              "minimum": 40,
              "maximum": 100,
              "default": 80,
              "description": "ASI_BANDWIDTHOVERLOAD: USB3.0転送帯域幅の制限 (%)"
            },
            "high_speed_mode": {
              "type": "boolean",
              "default": true,
              "description": "ASI_HIGH_SPEED_MODE: ハイスピードモード (グローバルシャッター120fps動作用)"
            },
            "hardware_bin": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "default": 1,
              "description": "ASI_HARDWARE_BIN: ハードウェアビンニング (9.0μmの大ピクセルのため基本1)"
            },
            "flip": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3,
              "default": 0,
              "description": "ASI_FLIP: 画像反転 (0:なし, 1:水平, 2:垂直, 3:両方)"
            }
          }
        },
        "auto_control": {
          "type": "object",
          "properties": {
            "auto_max_gain": {
              "type": "integer",
              "minimum": 0,
              "maximum": 400,
              "default": 0,
              "description": "ASI_AUTO_MAX_GAIN: 自動ゲイン上限 (解析時の閾値維持のため固定値運用時は0)"
            },
            "auto_max_exp": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1,
              "description": "ASI_AUTO_MAX_EXP: 自動露出上限 (ms)"
            },
            "auto_target_brightness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "default": 100,
              "description": "ASI_AUTO_TARGET_BRIGHTNESS: 自動露出の目標明るさ"
            }
          }
        },
        "image_format": {
          "type": "object",
          "properties": {
            "img_type": {
              "type": "string",
              "enum": [
                "RAW8",
                "RAW16",
                "Y8"
              ],
              "default": "RAW8",
              "description": "img_type: 画像フォーマット (ASI432MMはモノクロ専用。高速解析はRAW8、高階調は12bit RAW16)"
            }
          },
          "required": [
            "img_type"
          ]
        }
      }
    },
    "sun_find_west_v2": {
      "type": "object",
      "description": "Visualizer クラスのコンストラクタに渡すパラメータ",
        "properties":{
          "Analyzer":{"type":"object","properties":{
            "acceptable": {
              "type": "number",
              "default": 1,
              "minimum": 0,
              "maximum": 180,
              "description":"許容角度(degree)"
            },
            "buf_lookback":{
              "type": "integer",
              "default": "300",
              "minimum": "2",
              "description":"軌道推定に使うフレーム数"
            }
          }
        },
          "MIN2ver2":{"type":"object","version":"2.3.8","properties":{
            "n":{
              "type":"int",
              "minimum":1,
              "maximum":200,
              "default":10,
              "description":"画像格子の分割数"
            },
            "light_threshod":{
              "type":"int",
              "minimum":0,
              "default":50,
              "description":"太陽の明るさの基準しきい値,格子線が太陽像上を通るかの判定に用いる"
            },
            "limb_wigth":{
              "type":"int",
              "minimum":0,
              "default":"24",
              "description":"太陽の縁の幅の基準値(pix)"
              },
            "iter_cycles":{
              "type":"int",
              "minimum":0,
              "default":"2",
              "description":"黒点排除のイテレーション回数。複数の黒点に対応できます。0なら排除なし"
            }
          },
          "ransac":{"type":"object","version":"1.00","properties":{
            "NONE":{
              "type":"str",
              "default":"STUB",
              "description":"STUB"
              }
            }
          }
        },
          "Visualizer":{"type":"object","properties": {
            "grid_color": {
              "type": "string",
              "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
              "default": "#FFFFFF",
              "description": "画像グリッドの色(hex)"
            },
            "grid_ny": {
              "type": "integer",
              "minimum": 0,
              "default": 2,
              "description":"画像グリッドの縦分割数"
            },
            "grid_nx": {
              "type": "integer",
              "minimum": 0,
              "default": 4,
              "description":"画像グリッドの横分割数"
            },
            "grid_r": {
              "type": "number",
              "minimum": 0,
              "default": 300,
              "description": "中心円の半径(pixel)"
            },
            "grid_alpha": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.4,
              "description": "画像グリッドの透明度(alpha)"
            },
            "opencircle_triangle": {
              "type": "boolean",
              "default": false,
              "description": "西との角度差を表示する円弧に矢印をつける"
            }
            
          }
        }
      }
    }
  },
  "additionalProperties": false
}
